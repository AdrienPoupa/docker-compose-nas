# set paths to writable location as non-root by default
proxy_temp_path /tmp/proxy_temp;
client_body_temp_path /tmp/client_temp;
fastcgi_temp_path /tmp/fastcgi_temp;
uwsgi_temp_path /tmp/uwsgi_temp;
scgi_temp_path /tmp/scgi_temp;

server {
  listen ${TANDOOR_PORT};
  listen [::]:${TANDOOR_PORT} ipv6only=on;
  server_name localhost;

  client_max_body_size 512M;

  # serve media files
  location /recipes/media {
    alias ${MEDIA_ROOT};
    add_header Content-Disposition 'attachment; filename="$args"';
  }

  location /recipes/static {
    alias ${STATIC_ROOT};
  }

  # serve service worker under main path
  location = /recipes/service-worker.js {
    alias ${STATIC_ROOT}/vue3/service-worker.js;
  }

  # pass requests for dynamic content to gunicorn
  location / {
    proxy_set_header Host $http_host;
    proxy_pass http://unix:/tmp/tandoor.sock;

    # param needed by django allauth sessions to log IP
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_cookie_path / /recipes;

    # Upstream bug: ScopeMiddleware redirects unauthenticated users to
    # /account/login/ without the /recipes SCRIPT_NAME prefix. Gunicorn 26
    # rejects unprefixed paths, so re-add the prefix to relative redirects.
    proxy_redirect ~^/(?!recipes/)(.*)$ /recipes/$1;

    # disabled for now because it redirects to the error page and not back, also not showing html
    #error_page 502 /errors/http502.html;
  }

  location /recipes/errors/ {
    alias /etc/nginx/http.d/errorpages/;
    internal;
  }
}
